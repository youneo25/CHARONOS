IDI_APP ICON "@CMAKE_SOURCE_DIR@/res/app.ico"

#include <winver.h>
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "@CHARONOS_PRODUCT@ - Reference review for animators\0"
      VALUE "FileVersion", "@PROJECT_VERSION@\0"
      VALUE "InternalName", "@CHARONOS_EXE@\0"
      VALUE "OriginalFilename", "@CHARONOS_EXE@.exe\0"
      VALUE "ProductName", "@CHARONOS_PRODUCT@\0"
      VALUE "ProductVersion", "@PROJECT_VERSION@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
